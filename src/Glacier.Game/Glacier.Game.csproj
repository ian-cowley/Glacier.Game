<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Game</PackageId>
    <Version>1.1.1</Version>
    <PackageReleaseNotes>v1.1.1: Migrated from Glacier.Windowing to Glacier.Desktop 1.2.1 with aligned Graphics/Polaris/Tensor/Gpu dependencies.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>High-performance data-oriented Entity Component System (ECS) 2D/3D game engine for .NET 10 with AVX-512 physics, Glacier.Windowing native zero-allocation loop, Glacier.Graphics software/GPU rasterization, Direct3D 12 / Vulkan swapchains, and sub-3ms WASAPI audio.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Game</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Game.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>game;ecs;gamedev;pygame;simd;avx512;windowing;graphics;d3d12;vulkan;wasapi;audio;physics;net10;aot;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\Glacier.Desktop\src\Glacier.Desktop\Glacier.Desktop.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="..\..\..\Glacier.Desktop\src\Glacier.Desktop\Glacier.Desktop.csproj" />
    <ProjectReference Include="..\..\..\Glacier.Graphics\src\Glacier.Graphics\Glacier.Graphics.csproj" />
    <ProjectReference Include="..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj" />
    <ProjectReference Include="..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj" />
    <ProjectReference Include="..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\Glacier.Desktop\src\Glacier.Desktop\Glacier.Desktop.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Desktop" Version="1.2.1" />
    <PackageReference Include="Glacier.Graphics" Version="1.2.1" />
    <PackageReference Include="Glacier.Polaris" Version="1.2.6" />
    <PackageReference Include="Glacier.Tensor" Version="1.1.2" />
    <PackageReference Include="Glacier.Gpu" Version="1.2.1" />
  </ItemGroup>
</Project>
