<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Game</PackageId>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>v1.2.0: Hardened ECS unmanaged memory bounds/finalizers, multi-cell SIMD collision narrowphase, vectorized physics kernels, fast scanline triangle rasterizer, and emitter volume/loop audio support.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>High-performance data-oriented Entity Component System (ECS) 2D/3D game engine for .NET 10 with AVX-512 physics, Glacier.Desktop native zero-allocation loop, Glacier.Graphics software/GPU rasterization, Direct3D 12 / Vulkan swapchains, and sub-3ms WASAPI audio.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Game</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Game.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>game;ecs;gamedev;pygame;simd;avx512;windowing;graphics;d3d12;vulkan;wasapi;audio;physics;net10;aot;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Glacier.Desktop\src\Glacier.Desktop\Glacier.Desktop.csproj" Condition="Exists('..\..\..\Glacier.Desktop\src\Glacier.Desktop\Glacier.Desktop.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Desktop" Condition="!Exists('..\..\..\Glacier.Desktop\src\Glacier.Desktop\Glacier.Desktop.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="..\..\..\Glacier.Graphics\src\Glacier.Graphics\Glacier.Graphics.csproj" Condition="Exists('..\..\..\Glacier.Graphics\src\Glacier.Graphics\Glacier.Graphics.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Graphics" Condition="!Exists('..\..\..\Glacier.Graphics\src\Glacier.Graphics\Glacier.Graphics.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj" Condition="Exists('..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Polaris" Condition="!Exists('..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj" Condition="Exists('..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Tensor" Condition="!Exists('..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj" Condition="Exists('..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Gpu" Condition="!Exists('..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>
</Project>
